# Copy to .env and fill in real values.
PORT=3000
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
# bcrypt hash of your admin password. Generate with:
#   node -e "console.log(require('bcrypt').hashSync('your_password', 12))"
ADMIN_PASSWORD_HASH=$2b$12$CHANGE_ME
# Optional shared secret the app must send to self-register (header X-Registration-Key).
# Must match the REGISTRATION_KEY baked into the APK at build time. Leave unset = open registration.
REGISTRATION_KEY=
